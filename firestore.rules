rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // 1. 기본 원칙: Default Deny All
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 2. 인증 및 인가 헬퍼 함수
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    // authorizedUsers 컬렉션 존재 여부 및 active 상태 확인
    function isAuthorizedUser() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid)).data.active == true;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthorizedUser() && getUserData().role == 'admin';
    }

    // 일반 교사는 authorizedUsers 문서의 roomIds 배열에 포함된 교류방만 관리
    // admin은 모든 교류방 관리 가능
    function isTeacherForRoom(roomId) {
      return isAuthorizedUser() && (
        getUserData().role == 'admin' || (
          getUserData().role == 'teacher' && 
          roomId in getUserData().roomIds
        )
      );
    }

    // =========================================================================
    // 3. authorizedUsers 컬렉션 (인가된 교사 및 관리자 명부)
    // =========================================================================
    match /authorizedUsers/{uid} {
      // 본인의 인가 상태만 조회 가능 (타인 조회 불가)
      allow read: if isAuthenticated() && request.auth.uid == uid;
      // 클라이언트에서 권한 생성·수정·삭제는 절대 불가 (콘솔 또는 Admin SDK 전용)
      allow write: if false;
    }

    // =========================================================================
    // 4. rooms/{roomId} 교류방 계층
    // =========================================================================
    match /rooms/{roomId} {
      // 인증된 모든 참여자는 교류방 상태 읽기 가능
      allow read: if isAuthenticated();
      // 교류방 생성: admin 또는 담당 교사
      allow create: if isTeacherForRoom(roomId);
      // 교류방 정보 수정: 담당 교사 또는 admin (진행상태, 태스크 등)
      allow update: if isTeacherForRoom(roomId);
      // 영구 삭제: 클라이언트 절대 불가 (삭제는 isDeleted 또는 archivedAt 소프트 삭제만 허용)
      allow delete: if false;

      // -----------------------------------------------------------------------
      // 4-A. activities/{activityId} 활동 서브컬렉션
      // -----------------------------------------------------------------------
      match /activities/{activityId} {
        allow read: if isAuthenticated();
        // 담당 교사/admin만 활동 생성 및 수정(휴지통 이동 소프트 삭제 포함) 가능
        allow create, update: if isTeacherForRoom(roomId);
        // 활동 영구 삭제: 클라이언트 절대 불가
        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // 4-B. participants/{participantId} 참가자 명부 서브컬렉션
      // -----------------------------------------------------------------------
      match /participants/{participantId} {
        // [정보 노출 방지] 학생은 참가자 목록 전체 list 불가!
        // 본인에게 배정된 문서(authUid 일치) 또는 미배정 슬롯 검증 시 단일 get만 허용
        allow get: if isAuthenticated() && (
          isTeacherForRoom(roomId) ||
          resource.data.authUid == request.auth.uid ||
          resource.data.isClaimed == false
        );
        // 담당 교사만 참가자 전체 목록 조회(list) 가능
        allow list: if isTeacherForRoom(roomId);

        // 참가자 슬롯 생성: 담당 교사만 가능
        allow create: if isTeacherForRoom(roomId);
        // 참가자 슬롯 점유(익명 학생 authUid 바인딩) 또는 교사의 수정
        allow update: if (
          // 학생 본인의 슬롯 최초 점유
          isAuthenticated() &&
          resource.data.isClaimed == false &&
          request.resource.data.isClaimed == true &&
          request.resource.data.authUid == request.auth.uid &&
          request.resource.data.participantCode == resource.data.participantCode
        ) || isTeacherForRoom(roomId);
        // 참가자 영구 삭제: 절대 불가
        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // 4-C. submissions/{submissionId} 학생 제출물 서브컬렉션
      // -----------------------------------------------------------------------
      match /submissions/{submissionId} {
        allow read: if isAuthenticated();

        // 제출물 생성 조건 엄격 집행:
        // 1. authorUid == request.auth.uid
        // 2. 해당 participant 문서의 authUid == request.auth.uid
        // 3. roomId와 activityId 일치
        // 4. 활동이 published 상태이고 삭제되지 않음
        // 5. 마감시각(dueEpochMs) 이전 제출
        allow create: if isAuthenticated() &&
          request.resource.data.authorUid == request.auth.uid &&
          request.resource.data.roomId == roomId &&
          exists(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.resource.data.participantId)) &&
          get(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.resource.data.participantId)).data.authUid == request.auth.uid &&
          exists(/databases/$(database)/documents/rooms/$(roomId)/activities/$(request.resource.data.activityId)) &&
          get(/databases/$(database)/documents/rooms/$(roomId)/activities/$(request.resource.data.activityId)).data.status == 'published' &&
          get(/databases/$(database)/documents/rooms/$(roomId)/activities/$(request.resource.data.activityId)).data.isDeleted != true &&
          request.time.toMillis() <= get(/databases/$(database)/documents/rooms/$(roomId)/activities/$(request.resource.data.activityId)).data.dueEpochMs;

        // 제출물 수정 조건:
        // - 작성자 본인 수정: 마감 전 + 핵심 식별자(authorUid, participantId, activityId, roomId, submittedAt) 변경 불가
        // - 교사 수정: 학생 본문 변경 불가, 숨김(isHidden) 및 승인 상태만 조정 가능
        allow update: if (
          // 학생 본인 수정
          isAuthenticated() &&
          request.auth.uid == resource.data.authorUid &&
          request.resource.data.authorUid == resource.data.authorUid &&
          request.resource.data.participantId == resource.data.participantId &&
          request.resource.data.activityId == resource.data.activityId &&
          request.resource.data.roomId == resource.data.roomId &&
          request.resource.data.submittedAt == resource.data.submittedAt &&
          request.time.toMillis() <= get(/databases/$(database)/documents/rooms/$(roomId)/activities/$(resource.data.activityId)).data.dueEpochMs
        ) || (
          // 교사 관리(본문 조작 금지)
          isTeacherForRoom(roomId) &&
          request.resource.data.content == resource.data.content &&
          request.resource.data.authorUid == resource.data.authorUid
        );

        // 제출물 영구 삭제: 학생, 교사, 관리자 모두 절대 불가
        allow delete: if false;

        // ---------------------------------------------------------------------
        // 4-C-1. likes/{uid} 좋아요 서브컬렉션 (사용자당 1문서)
        // ---------------------------------------------------------------------
        match /likes/{uid} {
          allow read: if isAuthenticated();
          // 본인 UID로만 좋아요 생성 가능
          allow create: if isAuthenticated() &&
            request.auth.uid == uid &&
            request.resource.data.uid == request.auth.uid;
          // 본인 UID의 좋아요만 취소(삭제) 가능
          allow delete: if isAuthenticated() && request.auth.uid == uid;
          // 수정은 불가
          allow update: if false;
        }
      }

      // -----------------------------------------------------------------------
      // 4-D. comments/{commentId} 댓글 서브컬렉션
      // -----------------------------------------------------------------------
      match /comments/{commentId} {
        allow read: if isAuthenticated();

        // 댓글 생성: 승인된 참여자 본인만 가능
        allow create: if isAuthenticated() &&
          request.resource.data.authorUid == request.auth.uid &&
          request.resource.data.roomId == roomId &&
          exists(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.resource.data.participantId)) &&
          get(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.resource.data.participantId)).data.authUid == request.auth.uid;

        // 댓글 수정: 작성자 본인만 본문 수정(식별자 변경 불가) 또는 교사의 숨김 처리
        allow update: if (
          isAuthenticated() &&
          request.auth.uid == resource.data.authorUid &&
          request.resource.data.authorUid == resource.data.authorUid &&
          request.resource.data.submissionId == resource.data.submissionId &&
          request.resource.data.roomId == resource.data.roomId &&
          request.resource.data.createdAt == resource.data.createdAt
        ) || (
          isTeacherForRoom(roomId) &&
          request.resource.data.content == resource.data.content &&
          request.resource.data.authorUid == resource.data.authorUid
        );

        // 댓글 영구 삭제: 절대 불가 (필요시 isHidden 또는 isDeleted 소프트 처리)
        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // 4-E. schedules/{scheduleId} 수업 일정 서브컬렉션
      // -----------------------------------------------------------------------
      match /schedules/{scheduleId} {
        allow read: if isAuthenticated();
        allow create, update: if isTeacherForRoom(roomId);
        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // 4-F. teacherReviews/{reviewId} 교사 평가 및 피드백 서브컬렉션
      // -----------------------------------------------------------------------
      match /teacherReviews/{reviewId} {
        allow read: if isAuthenticated();
        allow create, update: if isTeacherForRoom(roomId);
        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // 4-G. teacherPrivateNotes/{noteId} 교사 비공개 관찰 메모 서브컬렉션
      // -----------------------------------------------------------------------
      match /teacherPrivateNotes/{noteId} {
        // 담당 roomIds에 포함된 교사 또는 admin만 접근 가능 (학생 원천 차단)
        allow read, create, update: if isTeacherForRoom(roomId);
        allow delete: if false;
      }
    }

    // =========================================================================
    // 5. teacherPrivateNotes/{noteId} 최상위 교사 비공개 관찰 메모 컬렉션
    // =========================================================================
    match /teacherPrivateNotes/{noteId} {
      // 담당 roomIds에 포함된 교사 또는 admin만 단일 조회(get) 및 목록 조회(list) 가능
      // 학생 접근 원천 차단
      allow get: if isTeacherForRoom(resource.data.roomId);
      allow list: if isAuthorizedUser() && (getUserData().role == 'admin' || getUserData().role == 'teacher');
      allow create: if isTeacherForRoom(request.resource.data.roomId);
      allow update: if isTeacherForRoom(resource.data.roomId) &&
                       isTeacherForRoom(request.resource.data.roomId);
      allow delete: if false;
    }

    // =========================================================================
    // 6. auditLogs/{logId} 불변 감사 로그
    // =========================================================================
    match /auditLogs/{logId} {
      // 교사 및 관리자만 감사 로그 열람 가능 (학생 열람 불가)
      allow read: if isAuthorizedUser();
      // 학생의 임의 로그 생성 차단: active 상태의 교사/관리자만 생성 가능
      allow create: if isAuthorizedUser() &&
        (getUserData().role == 'teacher' || getUserData().role == 'admin') &&
        request.resource.data.actorUid == request.auth.uid;
      // 생성 후 수정 및 삭제 절대 불가 (불변성 보장)
      allow update, delete: if false;
    }
  }
}
